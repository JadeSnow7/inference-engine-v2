# Default provider: normal writing, summary, rewrite, chat
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-v4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Special provider: hard reasoning, final polishing, long/important tasks
SPECIAL_PROVIDER=openai
SPECIAL_MODEL=gpt-5.5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional fallback provider
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_KNOWLEDGE_BASE_ID=
DASHSCOPE_RAG_MODEL=qwen-plus
RAG_PROVIDER=disabled

# App settings
JWT_SECRET=
REDIS_URL=redis://redis:6379/0
MAX_HISTORY_TOKENS=6000
CORS_ORIGINS=http://www.hustjxfz.top,https://www.hustjxfz.top

# Local knowledge base / RAG
ENABLE_LOCAL_RAG=0
EMBED_MODEL=BAAI/bge-small-zh-v1.5
GRAPH_PERSIST_PATH=data/knowledge_graph.gpickle
